[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Tabique pintado. El boceto es `pared.jpg` del original —hormigón claro con
; manchas— pero limpio: en el remake el edificio está en uso, no en obra.
; Valor medio-alto a propósito, porque es el fondo contra el que se recortan
; las siluetas oscuras de los enemigos.
;
; Proyección triplanar en espacio de mundo: la geometría del mapa son cajas de
; tamaño arbitrario y con UV por cara la densidad de téxel cambiaría de un muro
; a otro. Así se mide en metros (uv1_scale), no en caras.

[ext_resource type="Texture2D" path="res://assets/textures/modern/wall_albedo.png" id="Albedo"]
[ext_resource type="Texture2D" path="res://assets/textures/modern/wall_normal.png" id="Normal"]

[resource]
albedo_color = Color(0.74, 0.73, 0.70, 1)
albedo_texture = ExtResource("Albedo")
normal_enabled = true
normal_texture = ExtResource("Normal")
normal_scale = 0.3
roughness = 0.9
metallic = 0.0
metallic_specular = 0.2
uv1_scale = Vector3(0.5, 0.5, 0.5)
uv1_triplanar = true
uv1_world_triplanar = true
