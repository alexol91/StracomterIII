[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Placas de techo acústico: retícula de 60 cm, casi blanca, con el punteado de
; la fibra mineral. Rebota la luz hacia abajo y mantiene legible el suelo, que
; es donde ocurre el juego.
;
; En 2012 no había techo visible —cámara cenital—, así que aquí no hay original
; que respetar y manda la función.

