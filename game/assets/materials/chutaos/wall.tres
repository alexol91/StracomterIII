[gd_resource type="StandardMaterial3D" load_steps=2 format=3]

; Muro de 2012 tal cual: `pared.jpg`, el hormigón con remaches que
; ResourceManager.cc:867 asignaba a Texturas::t_wall.
;
; A propósito SIN triplanar y con uv1_scale a 1: el original estiraba la
; textura por cara, así que un muro largo la deformaba más que uno corto. Eso
; no es un defecto que haya que corregir aquí, es exactamente lo que se veía, y
; corregirlo dejaría el modo chutaos a medias.

[ext_resource type="Texture2D" path="res://assets/textures/chutaos/pared.jpg" id="Tex"]

[resource]
albedo_color = Color(1, 1, 1, 1)
albedo_texture = ExtResource("Tex")
uv1_scale = Vector3(1, 1, 1)
roughness = 1.0
metallic = 0.0
metallic_specular = 0.0
