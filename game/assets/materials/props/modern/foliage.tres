[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Follaje de la maceta. Es el verde más saturado del mapa y está bien que lo
; sea: el GDD (§9) dice que una planta no protege de nada pero rompe la línea
; de visión, así que el jugador necesita reconocerla de un vistazo y no
; confundirla con una cobertura.
;
; `cull_mode = 0` y sombreado a dos caras: las hojas del modelo de 2012 son
; polígonos sueltos, y sin esto la mitad de la planta desaparece según desde
; dónde se mire.

[ext_resource type="Texture2D" path="res://assets/textures/modern/foliage_albedo.png" id="Albedo"]
[ext_resource type="Texture2D" path="res://assets/textures/modern/foliage_normal.png" id="Normal"]

[resource]
albedo_color = Color(0.82, 0.92, 0.80, 1)
albedo_texture = ExtResource("Albedo")
normal_enabled = true
normal_texture = ExtResource("Normal")
normal_scale = 0.7
roughness = 0.8
metallic = 0.0
metallic_specular = 0.2
cull_mode = 2
uv1_scale = Vector3(2, 2, 2)
uv1_triplanar = true
uv1_world_triplanar = true
