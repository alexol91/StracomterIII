[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Tapicería de sofá y sillón. El original los vestía a los dos con `sAzul.png`,
; un azul liso; aquí se mantiene la familia azul grisácea —el mueble sigue
; siendo reconocible— con la trama del tejido de verdad.
;
; Se sale del gris del resto del mundo lo justo: un sofá es de las pocas cosas
; a las que un jugador se acerca a propósito para parapetarse.

[ext_resource type="Texture2D" path="res://assets/textures/modern/upholstery_albedo.png" id="Albedo"]
[ext_resource type="Texture2D" path="res://assets/textures/modern/upholstery_normal.png" id="Normal"]

