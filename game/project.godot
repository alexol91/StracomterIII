; Stracomter III: Torre Elite — remake 2026 en Godot 4.7
; Proyecto original: Chutaos Team, Universidad de Alicante, 2011-2012
; Todo fichero de escena y recurso se guarda en TEXTO (ver ADR-001).

config_version=5

[application]

config/name="Stracomter III: Torre Elite"
config/description="Shooter tactico en tercera persona. Remake del proyecto universitario StracomterIII (2012)."
config/version="0.1.0-dev"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
Balance="*res://src/core/balance.gd"
GameState="*res://src/core/game_state.gd"
Blackboard="*res://src/core/blackboard.gd"
AIScheduler="*res://src/core/ai_scheduler.gd"
SaveSystem="*res://src/core/save_system.gd"
AudioDirector="*res://src/core/audio_director.gd"
DevConsole="*res://src/core/dev_console.gd"
PresentationStyle="*res://src/gameplay/presentation_style.gd"
GameCheats="*res://src/core/game_cheats.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[input]

move_forward={ "deadzone": 0.2, "events": [] }
move_back={ "deadzone": 0.2, "events": [] }
move_left={ "deadzone": 0.2, "events": [] }
move_right={ "deadzone": 0.2, "events": [] }
sprint={ "deadzone": 0.5, "events": [] }
crouch={ "deadzone": 0.5, "events": [] }
fire={ "deadzone": 0.5, "events": [] }
aim={ "deadzone": 0.5, "events": [] }
melee={ "deadzone": 0.5, "events": [] }
reload={ "deadzone": 0.5, "events": [] }
ability={ "deadzone": 0.5, "events": [] }
interact={ "deadzone": 0.5, "events": [] }
squad_order={ "deadzone": 0.5, "events": [] }
toggle_camera={ "deadzone": 0.5, "events": [] }
toggle_console={ "deadzone": 0.5, "events": [] }
pause={ "deadzone": 0.5, "events": [] }

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="companion"
3d_physics/layer_4="enemy"
3d_physics/layer_5="projectile"
3d_physics/layer_6="pickup"
3d_physics/layer_7="door"
3d_physics/layer_8="cover_probe"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.2

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
